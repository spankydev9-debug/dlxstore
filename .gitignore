# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local database exports and storage backups are recovery artifacts, never source-controlled.
# See AGENT_HANDOFF.md §3 rule 5 and BACKLOG.md OPS-6 for backup requirements.
storage_backup/
dlxstore_backup_*.json
dlxstore_backup_*.sql
/dlxstore_data_backup.sql
/dlxstore_remote_backup.sql
# Supabase Storage export archives. Named dlxstore_<kind>_backup_<date>.tar.gz, so match on
# both the project prefix and the date suffix. The 2026-09-30 archive was 25 MB of the public
# product-images bucket and had no .gitignore entry, so `git add -A` would have committed it.
dlxstore_*_backup_*.tar.gz
dlxstore_*.tar.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
