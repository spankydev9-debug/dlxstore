# DLXSTORE Environment Variables
# Do NOT place actual secrets in this file. Use this as a template.

# Supabase Configuration
# Required for database access and authentication if not using the local mock fallback.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Preferred current client-side key. Safe to expose in the browser under Supabase RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy alternative only; leave unset when using the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development only. Keep false for all production deployments.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Note: The service role key should NEVER be exposed client-side (NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
