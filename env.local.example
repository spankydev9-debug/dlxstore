# ============================================================
# DLXSTORE — Local Development Environment Template
# Copy this file to .env.local and fill in your dev values.
# NEVER point .env.local at the production Supabase project
# during local development — local dev writes go to production data.
# ============================================================

# --- DEV Supabase project (create a separate project at supabase.com) ---
# Production project ref: szhkesvvrgcxbxucodzz (DO NOT use here for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_DEV_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<YOUR_DEV_PUBLISHABLE_KEY>
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# --- Site URL (use localhost for local dev) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vercel OIDC (populated automatically by: vercel env pull) ---
# VERCEL_OIDC_TOKEN=...
